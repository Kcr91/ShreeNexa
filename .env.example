# ShreeNexa Environment Configuration Template
# Copy this file to .env for local development overrides.
# NEVER put real credentials in this file -- it is tracked in git.

# Environment: development, staging, production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Authoritative Transactional Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://shreenexa:shreenexa_dev@127.0.0.1:5432/shreenexa

# Reconstructible Hot State and Cache (Valkey / Redis)
REDIS_URL=redis://127.0.0.1:6379/0

# DhanHQ Data API Credentials
# In production, inject these via server-side environment variables.
# For local Windows development, prefer the encrypted DPAPI store instead of
# putting the token on disk in plaintext:
#     python -m app.dhan.token set
# Manually generated Dhan Web access tokens are valid for 24 hours.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Absolute ISO 8601 timestamp, e.g. 2026-09-04T14:30:58+00:00.
# Leave blank to derive expiry automatically from the token's own `exp` claim.
DHAN_TOKEN_EXPIRES_AT=
