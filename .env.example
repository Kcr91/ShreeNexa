# ShreeNexa Environment Configuration Template
# Copy this file to .env for local development overrides

# Environment: development, staging, production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Authoritative Transactional Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://shreenexa:shreenexa_dev@127.0.0.1:5432/shreenexa

# Reconstructible Hot State and Cache (Valkey / Redis)
REDIS_URL=redis://127.0.0.1:6379/0

# DhanHQ Data API Credentials
# In production, inject these via server-side environment variables.
# In local development, credentials can also be stored encrypted via Windows DPAPI.
# Note: Manually generated Dhan Web access tokens are valid for 24 hours.
DHAN_CLIENT_ID=1111713478
DHAN_ACCESS_TOKEN=
DHAN_TOKEN_EXPIRES_AT=24 hours
